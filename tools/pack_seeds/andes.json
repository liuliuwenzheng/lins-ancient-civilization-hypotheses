  "claims": [
    {
      "id": "claim-andes-norte-chico-late-archaic-frame",
      "kind": "fact",
      "statement": {
        "zh": "Norte Chico 晚古风大型遗址群以纪念性建筑、广泛居住建筑与无陶为共性，测年总框约 3000–1800 cal BCE。",
        "en": "Norte Chico Late Archaic large sites share monumental architecture, extensive residential architecture, and aceramic assemblages, framed ~3000–1800 cal BCE."
      },
