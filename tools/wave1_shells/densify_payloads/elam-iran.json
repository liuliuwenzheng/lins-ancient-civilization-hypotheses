  "claims": [
    {
      "id": "claim-elam-susa-unesco-stratified-mounds",
      "kind": "fact",
      "statement": {
        "zh": "教科文将苏萨表述为自晚五千年纪 BCE 起连续叠压的城市定居土丘群，含行政、居住与宫殿遗存（UNESCO 1455）。",
        "en": "UNESCO frames Susa as mounds with continuous superimposed urban settlement from the late 5th millennium BCE, including administrative, residential, and palatial remains (UNESCO 1455)."
      },
      "site_ids": [
        "site-susa"
      ],
      "period_ids": [
        "period-elam-overview"
      ],
      "sources": [
