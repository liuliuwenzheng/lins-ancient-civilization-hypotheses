  "claims": [
    {
      "id": "claim-zapotec-unesco-monte-alban",
      "kind": "fact",
      "statement": {
        "zh": "教科文将蒙特·阿尔班列为瓦哈卡谷地古代萨波特克考古遗址（与瓦哈卡历史中心一并列入）（UNESCO 415）。",
        "en": "UNESCO lists Monte Albán as the ancient Zapotec archaeological site of the Valley of Oaxaca (with the historic centre of Oaxaca) (UNESCO 415)."
      },
      "site_ids": [
        "site-monte-alban"
      ],
      "period_ids": [
        "period-zapotec-monte-alban-florescence"
      ],
      "sources": [
        "src-zapotec-unesco-monte-alban-415",
        "src-zapotec-unesco-415-maps",
        "src-zapotec-blanton-monte-alban-1978"
      ],
      "object_ids": []
    },
    {
      "id": "claim-zapotec-blanton-settlement-mapping",
      "kind": "fact",
      "statement": {
        "zh": "Blanton 1978 聚落形态专著系统测绘蒙特·阿尔班山巅都城地表建筑与居住区（Blanton 1978）。",
        "en": "Blanton 1978 systematically mapped surface architecture and residential zones of the Monte Albán hilltop capital (Blanton 1978)."
      },
      "site_ids": [
        "site-monte-alban"
      ],
      "period_ids": [
        "period-zapotec-monte-alban-florescence"
      ],
      "sources": [
