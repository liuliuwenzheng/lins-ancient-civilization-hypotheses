        "src-zapotec-blanton-feinman-kowalewski"
      ],
      "object_ids": [
        "asm-monte-alban-settlement-frame"
      ]
    },
    {
      "id": "claim-zapotec-san-jose-mogote-formative",
      "kind": "fact",
      "statement": {
        "zh": "发掘传统将圣何塞·莫戈特表述为蒙特·阿尔班建城之前的关键形成期村落中心（Flannery & Marcus）。",
        "en": "Excavation tradition frames San José Mogote as a key Formative village centre before Monte Albán’s foundation (Flannery & Marcus)."
