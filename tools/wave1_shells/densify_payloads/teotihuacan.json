  "claims": [
    {
      "id": "claim-teotihuacan-unesco-metropolis",
      "kind": "fact",
      "statement": {
        "zh": "教科文将特奥蒂瓦坎表述为墨西哥盆地经典期规划大都，含太阳/月亮金字塔与羽蛇神庙等巨构（UNESCO 414）。",
        "en": "UNESCO frames Teotihuacan as a planned Classic metropolis in the Basin of Mexico with monumental pyramids and the Temple of Quetzalcoatl (UNESCO 414)."
      },
      "site_ids": [
        "site-teotihuacan"
      ],
      "period_ids": [
        "period-teotihuacan-classic-floruit"
      ],
      "sources": [
        "src-teotihuacan-unesco-414",
        "src-teotihuacan-unesco-414-maps",
        "src-teotihuacan-cowgill-2015"
      ],
      "object_ids": []
    },
    {
      "id": "claim-teotihuacan-tmp-grid",
      "kind": "fact",
      "statement": {
        "zh": "Millon 测绘项目系统调查城市网格与地表采集，为都市规模提供关键证据（TMP；Antiquity data paper）。",
        "en": "Millon’s Mapping Project systematically surveyed the city grid and surface collections, providing key evidence for urban scale (TMP; Antiquity data paper)."
      },
      "site_ids": [
        "site-teotihuacan"
      ],
      "period_ids": [
        "period-teotihuacan-classic-floruit"
      ],
