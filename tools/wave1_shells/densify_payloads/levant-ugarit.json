  "claims": [
    {
      "id": "claim-ugarit-yon-city-layout",
      "kind": "fact",
      "statement": {
        "zh": "Yon 综合依据长期发掘将拉斯沙姆拉表述为含宫殿、卫城神庙与港口联系的晚青铜都城（Yon 2006）。",
        "en": "Yon’s synthesis, based on long-term excavation, frames Ras Shamra as an LBA capital with palace, acropolis temples, and port links (Yon 2006)."
      },
      "site_ids": [
        "site-ras-shamra-ugarit",
        "site-minet-el-beida"
      ],
      "period_ids": [
        "period-ugarit-lba-floruit"
      ],
      "sources": [
        "src-ugarit-yon-2006",
        "src-ugarit-courtois-orientation",
        "src-ugarit-schaeffer-orientation"
      ],
      "object_ids": []
    },
    {
      "id": "claim-ugarit-minet-port",
      "kind": "fact",
      "statement": {
        "zh": "发掘传统将米内特·贝达与乌加里特外港功能相联系（Yon；Schaeffer 传统）。",
        "en": "Excavation tradition links Minet el-Beida with Ugarit’s port function (Yon; Schaeffer tradition)."
      },
      "site_ids": [
        "site-minet-el-beida",
        "site-ras-shamra-ugarit"
      ],
      "period_ids": [
        "period-ugarit-lba-floruit"
      ],
      "sources": [
        "src-ugarit-yon-2006",
        "src-ugarit-schaeffer-orientation"
      ],
      "object_ids": []
    },
    {
      "id": "claim-ugarit-alphabetic-cuneiform-corpus",
      "kind": "fact",
      "statement": {
        "zh": "语料传统将乌加里特字母楔形泥板作为西北闪语与仪礼文本的核心档案（Pardee；KTU/CAT；Bordreuil & Pardee）。",
        "en": "Corpus tradition treats Ugaritic alphabetic-cuneiform tablets as a core archive for NW Semitic and ritual texts (Pardee; KTU/CAT; Bordreuil & Pardee)."
      },
      "site_ids": [
        "site-ras-shamra-ugarit"
      ],
      "period_ids": [
        "period-ugarit-lba-floruit"
      ],
      "sources": [
        "src-ugarit-pardee-text-orientation",
        "src-ugarit-dietrich-lorez-orientation",
        "src-ugarit-bordreuil-pardee-manual"
      ],
      "object_ids": [
        "asm-ugarit-alphabetic-cuneiform-frame"
      ]
    },
    {
      "id": "claim-ugarit-akkadian-international-letters",
      "kind": "fact",
      "statement": {
        "zh": "阿卡德书信与条约文本将乌加里特定位在晚青铜国际通信网络中（Lackenbacher/Malbran；Singer）。",
        "en": "Akkadian letters and treaty texts place Ugarit in the LBA international correspondence network (Lackenbacher/Malbran; Singer)."
      },
      "site_ids": [
        "site-ras-shamra-ugarit"
      ],
      "period_ids": [
        "period-ugarit-international-age"
      ],
      "sources": [
        "src-ugarit-lackenbacher-malbran-orientation",
        "src-ugarit-singer-political-orientation"
      ],
      "object_ids": [
        "asm-ugarit-akkadian-letters-frame"
      ]
    },
    {
      "id": "claim-ugarit-archive-topography",
      "kind": "fact",
      "statement": {
        "zh": "档案地形研究讨论泥板出土地点与城市功能分区的关系（van Soldt；Yon）。",
        "en": "Archive-topography studies discuss relations between tablet findspots and urban functional zones (van Soldt; Yon)."
      },
