{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liuliuwenzheng/lins-ancient-civilization-hypotheses/main/schemas/deliberation.schema.json",
  "title": "Deliberation (optional stub)",
  "description": "Machine-readable stub pointing at deliberations/*.md. Full session trail remains Markdown.",
  "type": "object",
  "required": ["id", "entity", "status", "perspective", "person_endorsement", "question"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^delib-[a-z0-9-]+$" },
    "entity": { "const": "deliberation" },
    "status": { "type": "string", "enum": ["open", "synthesized", "archived"] },
    "perspective": { "const": true },
    "person_endorsement": { "const": false },
    "seats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "question": { "type": "string" },
    "target_civilization_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^civ-[a-z0-9-]+$" }
    },
    "markdown_path": { "type": ["string", "null"] },
    "editorial": { "$ref": "common.defs.json#/$defs/EditorialProvenance" }
  }
}
